{
    "name": "doordash-campaign-agent",
    "version": "1.0.0",
    "description": "DoorDash Campaign Agent - Multi-account campaign management, optimization, and browser automation",
    "main": "dist/server/index.js",
    "scripts": {
        "build": "tsc",
        "automation:weekly:production": "tsx scripts/run-weekly-production.ts",
        "preflight:production": "tsx scripts/run-production-preflight.ts",
        "validate:production-store-config": "tsx scripts/validate-production-store-config.ts",
        "test:weekly-window": "tsx scripts/test-weekly-window.ts",
        "test:production-sanitization": "tsx scripts/test-production-sanitization.ts",
        "test:production-public-diagnostics": "tsx scripts/test-production-public-diagnostics.ts",
        "test:production-postgres-tls": "tsx scripts/test-production-postgres-tls.ts",
        "test:production-rules": "tsx scripts/test-production-rules-provider.ts",
        "test:production-hybrid": "tsx scripts/test-production-hybrid-provider.ts",
        "test:production-preflight-rules": "tsx scripts/test-production-preflight-rules.ts",
        "test:production-openai": "tsx scripts/test-production-openai-provider.ts",
        "test:production-ingestion": "tsx scripts/test-production-report-ingestion.ts",
        "test:production-postgres": "tsx scripts/test-production-postgres.ts",
        "test:production-runner": "tsx scripts/test-production-runner.ts",
        "test:production-storage": "tsx scripts/test-production-storage.ts",
        "test:workflow-validation": "tsx scripts/validate-production-workflow.ts",
        "start": "node dist/server/index.js",
        "dev": "tsx watch src/server/index.ts",
        "client": "cd client && npm run dev",
        "dev:all": "concurrently \"npm run dev\" \"npm run client\"",
        "setup": "npx playwright install chromium",
        "db:init": "tsx src/server/db/init.ts",
        "audit:campaigns": "tsx src/audit/run-campaign-audit.ts"
    },
    "dependencies": {
        "adm-zip": "^0.6.0",
        "better-sqlite3": "^11.0.0",
        "cors": "^2.8.5",
        "csv-parse": "^7.0.1",
        "dotenv": "^16.4.0",
        "express": "^4.18.0",
        "imapflow": "^1.4.7",
        "mailparser": "^3.9.14",
        "node-cron": "^3.0.3",
        "openai": "^5.23.0",
        "playwright": "^1.40.0",
        "pg": "^8.16.3",
        "uuid": "^9.0.0",
        "xlsx": "^0.18.5",
        "yaml": "^2.8.1"
    },
    "devDependencies": {
        "@types/adm-zip": "^0.5.8",
        "@types/better-sqlite3": "^7.6.0",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/mailparser": "^3.4.6",
        "@types/pg": "^8.15.5",
        "@types/node": "^20.11.0",
        "@types/node-cron": "^3.0.11",
        "@types/uuid": "^9.0.7",
        "concurrently": "^8.2.0",
        "tsx": "^4.7.0",
        "typescript": "^5.3.0"
    }
}
