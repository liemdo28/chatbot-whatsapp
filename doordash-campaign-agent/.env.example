DD_EXECUTION_ENV=development
DD_ANALYSIS_PROVIDER=openai
DD_REPORT_SOURCE=imap
DD_STORAGE_BACKEND=sqlite
DD_SCHEDULER_TIMEZONE=America/Los_Angeles

OPENAI_API_KEY=
OPENAI_MODEL=

DB_PATH=./data/doordash-campaigns.db
DATABASE_URL=

DD_REPORT_ALLOWED_SENDERS=reports@doordash.com
DD_REPORT_SUBJECT_INCLUDES=DoorDash,marketing report
DD_REPORT_INBOX_LABEL=INBOX
DD_REPORT_LOOKBACK_HOURS=240
DD_REPORT_RETRY_ATTEMPTS=3
DD_REPORT_RETRY_DELAY_MS=2000
DD_REPORT_DELIVERY_GRACE_HOURS=36

IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=

DD_DIAGNOSTICS_DIR=./artifacts/weekly-production
DD_FIXTURE_REPORT_DIR=./data/fixtures/reports
