$outFile = "C:\Ld-project\doordash-validation.txt"
"=== DoorDash Campaign Agent Validation ===" | Out-File $outFile
"Time: $(Get-Date)" | Out-File $outFile -Append

# GET /
try {
    $r = Invoke-WebRequest -Uri "http://localhost:3001/" -UseBasicParsing -TimeoutSec 5 -ErrorAction Stop
    "GET /: $($r.StatusCode) - $($r.Content)" | Out-File $outFile -Append
} catch {
    "GET /: FAILED - $($_.Exception.Message)" | Out-File $outFile -Append
}

# GET /health
try {
