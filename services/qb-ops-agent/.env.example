# QB Ops Agent — Environment Variables
# Copy this file to .env and fill in values

# ─── Connection ────────────────────────────────────────────────────────────────
# Port the agent listens on (QB Web Connector calls this)
PORT=3456

# ─── Authentication ───────────────────────────────────────────────────────────
# Username QBWC will send (used in authenticate step)
QB_USER=mi-admin

# Password QBWC will send (also used as QB_API_KEY)
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
QB_API_KEY=REPLACE_WITH_32_CHAR_KEY

# ─── mi-core ─────────────────────────────────────────────────────────────────
# URL of mi-core server (the primary Windows PC running mi-core OS)
AGENT_OS_API_URL=http://192.168.1.50:4001

# ─── QuickBooks ──────────────────────────────────────────────────────────────
# Path to company file (used in authenticate response)
QB_COMPANY_FILE=C:\ProgramData\Intuit\QuickBooks\Company Files\MI_CEO.qbw

# ─── Logging ─────────────────────────────────────────────────────────────────
# Options: error | warn | info | debug
LOG_LEVEL=info

# ─── Network ─────────────────────────────────────────────────────────────────
# IP of laptop1 on LAN (for .qwc AppURL generation)
LAPTOP1_IP=192.168.1.100
