# Agent Identity
AGENT_NAME=qb-ops-agent
AGENT_ENV=local

# API Endpoints
AGENT_OS_API_URL=http://127.0.0.1:3456/api
DASHBOARD_API_URL=https://dashboard.bakudanramen.com/api

# Mi-Core OS (for command polling + ingest)
MI_CORE_URL=http://localhost:4001
MI_CORE_API_KEY=

# Machine Auth Token (generated on first run, stored in .machine_token)
MACHINE_TOKEN=

# Local Database
LOCAL_DB_PATH=./data/qb-ops-agent.sqlite

# QBWC Server
QBWC_PORT=3457
QB_USER=mi-qb-agent
QB_API_KEY=b149c4783a1109ff46d01498d91766e7
QB_COMPANY_FILE=C:\ProgramData\Intuit\QuickBooks\Company Files\MI_CEO.qbw

# Machine Identity
MACHINE_ID=qb-laptop-01
LAPTOP1_IP=192.168.1.100

# Timing
HEARTBEAT_INTERVAL_SECONDS=60
WORKFLOW_CHECK_INTERVAL_MINUTES=15
COMMAND_POLL_INTERVAL_SECONDS=60

# Safety Flags (Phase 1: both must be false)
ENABLE_QB_WRITE_ACTIONS=false
ENABLE_SCREEN_AUTOMATION=false

# Logging
LOG_LEVEL=info
LOG_DIR=./logs
